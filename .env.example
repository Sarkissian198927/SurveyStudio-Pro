# Copy to .env (API env loaded from repository root when running pnpm workspace scripts)
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://survey:survey_dev_only@localhost:5432/surveystudio
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
COOKIE_SECURE=false

# Separate persistent encryption key; protect backups of this key separately. Do not rotate without migrating encrypted data.
DATA_ENCRYPTION_KEY=replace-with-a-separate-data-encryption-key
# Optional SMTP transport. Leave unset for local development mailbox only.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
